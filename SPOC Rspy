--- Prevents remote spam from causing lag (clears logs after `getgenv().SIMPLESPYCONFIG_MaxRemotes` or 500 remotes)
function clean()
    local max = getgenv().SIMPLESPYCONFIG_MaxRemotes
    if typeof(max) ~= "number" then
        max = 500
    end
    if #remoteLogs > max then
        local keep = 100
        local removeCount = #remoteLogs - keep
        for i = 1, removeCount do
            local v = remoteLogs[i]
            if typeof(v[1]) == "RBXScriptConnection" then
                pcall(function()
                    v[1]:Disconnect()
                end)
            end
            if typeof(v[2]) == "Instance" then
                pcall(function()
                    v[2]:Destroy()
                end)
            end
        end
        local newLogs = {}
        for i = removeCount + 1, #remoteLogs do
            table.insert(newLogs, remoteLogs[i])
        end
        remoteLogs = newLogs
    end
end

