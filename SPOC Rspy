            if blockcheck then return end
        end
    end
    return originalfunction(...)
end

local newnamecall = newcclosure(function(...)
    local args = {...}
    local ok, res = xpcall(function()
        local method = getnamecallmethod()
        if method and (method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer") then
            local self = args[1]
            if typeof(self) == "Instance" then
                local remote = cloneref(self)
                local isRemote = false
                pcall(function()
                    isRemote = IsA(remote,"RemoteEvent") or IsA(remote,"RemoteFunction") or IsA(remote,"UnreliableRemoteEvent")
                end)
                if isRemote then
                    local id = ThreadGetDebugId(remote)
                    local blockcheck = tablecheck(blocklist,remote,id)
                    local callargs = {select(2, unpack(args))}
                    local cyclic = false
                    pcall(function()
                        cyclic = IsCyclicTable(callargs)
                    end)
                    if not tablecheck(blacklist,remote,id) and not cyclic then
                        local data = {
                            method = method,
                            remote = remote,
                            args = deepclone(callargs),
                            infofunc = infofunc,
                            callingscript = callingscript,
                            metamethod = "__namecall",
                            blockcheck = blockcheck,
                            id = id,
                            returnvalue = {}
                        }
                        pcall(schedule, remoteHandler, data)
                    end
                    if blockcheck then
                        return nil
                    end
                end
            end
        end
        return originalnamecall(unpack(args))
    end, function(err)
        warn("[SimpleSpy] namecall log err:", err)
        return originalnamecall(unpack(args))
    end)
    if ok then
        return res
    end
    return originalnamecall(unpack(args))
end)

local newFireServer = newcclosure(function(...)
    return newindex("FireServer",originalEvent,...)
end)

local newUnreliableFireServer = newcclosure(function(...)
    return newindex("FireServer",originalUnreliableEvent,...)
end)

local newInvokeServer = newcclosure(function(...)
    return newindex("InvokeServer",originalFunction,...)
end)

local hooksActive = false

local function disablehooks()
    if not hooksActive then
        return
    end
    hooksActive = false
    pcall(function()
        if synv3 then
            if unhook and originalnamecall then
                unhook(getrawmetatable(game).__namecall, originalnamecall)
            end
            if unhook and originalEvent then
                unhook(Instance.new("RemoteEvent").FireServer, originalEvent)
            end
            if unhook and originalFunction then
                unhook(Instance.new("RemoteFunction").InvokeServer, originalFunction)
            end
            if unhook and originalUnreliableEvent then
                pcall(function()
                    unhook(Instance.new("UnreliableRemoteEvent").FireServer, originalUnreliableEvent)
                end)
            end
            if restorefunction then
                pcall(restorefunction, originalnamecall)
                pcall(restorefunction, originalEvent)
                pcall(restorefunction, originalFunction)
            end
            return
        end
        if typeof(hookmetamethod) == "function" and originalnamecall then
            pcall(hookmetamethod, game, "__namecall", originalnamecall)
        elseif typeof(hookfunction) == "function" and originalnamecall then
            local mt = getrawmetatable and getrawmetatable(game)
            if mt and mt.__namecall then
                pcall(hookfunction, mt.__namecall, originalnamecall)
            end
        end
        if typeof(hookfunction) == "function" then
            pcall(function()
                hookfunction(Instance.new("RemoteEvent").FireServer, originalEvent)
            end)
            pcall(function()
                hookfunction(Instance.new("RemoteFunction").InvokeServer, originalFunction)
            end)
            pcall(function()
                hookfunction(Instance.new("UnreliableRemoteEvent").FireServer, originalUnreliableEvent)
            end)
        end
    end)
end

--- Toggles on and off the remote spy
function toggleSpy()
    if not toggle then
        local oldnamecall
        local hasHM = typeof(hookmetamethod) == "function"
        local hasHF = typeof(hookfunction) == "function"
        local hasSyn = synv3 and typeof(hook) == "function"
        warn("[SimpleSpy] APIs hookmetamethod=", hasHM, "hookfunction=", hasHF, "getnamecallmethod=", typeof(getnamecallmethod) == "function")
        if not hasHM and not hasHF and not hasSyn then
            warn("[SimpleSpy] no hook APIs; remotes will not be logged")
            return
        end

        originalnamecall = function(...)
            return oldnamecall(...)
        end

        local ok, err = pcall(function()
            if hasSyn then
                oldnamecall = hook(getrawmetatable(game).__namecall, newnamecall)
                originalEvent = hook(Instance.new("RemoteEvent").FireServer, newFireServer)
                originalFunction = hook(Instance.new("RemoteFunction").InvokeServer, newInvokeServer)
                pcall(function()
                    originalUnreliableEvent = hook(Instance.new("UnreliableRemoteEvent").FireServer, newUnreliableFireServer)
                end)
            else
                if hasHM then
                    oldnamecall = hookmetamethod(game, "__namecall", newnamecall)
                elseif hasHF and typeof(getrawmetatable) == "function" then
                    oldnamecall = hookfunction(getrawmetatable(game).__namecall, newnamecall)
                else
                    error("cannot hook __namecall")
                end
                if hasHF then
                    originalEvent = hookfunction(Instance.new("RemoteEvent").FireServer, newFireServer)
                    originalFunction = hookfunction(Instance.new("RemoteFunction").InvokeServer, newInvokeServer)
                    pcall(function()
                        originalUnreliableEvent = hookfunction(Instance.new("UnreliableRemoteEvent").FireServer, newUnreliableFireServer)
                    end)
                end
            end
        end)
        if not ok then
            warn("[SimpleSpy] hook install failed:", err)
            return
        end
        if typeof(oldnamecall) ~= "function" then
            warn("[SimpleSpy] hookmetamethod did not return original; logging may fail")
        end
        hooksActive = true
        warn("[SimpleSpy] hooks active")
    else
        disablehooks()
    end
end

--- Toggles between the two remotespy methods (hookfunction currently = disabled)
function toggleSpyMethod()
    toggleSpy()
    toggle = not toggle
end

--- Shuts down the remote spy
local function shutdown()
    pcall(function()
        if schedulerconnect then
            schedulerconnect:Disconnect()
        end
    end)
    pcall(function()
        for _, connection in next, connections do
            pcall(function()
                connection:Disconnect()
            end)
        end
    end)
    pcall(function()
        for i,v in next, running_threads do
            if ThreadIsNotDead(v) then
                pcall(close, v)
            end
        end
    end)
    pcall(clear, running_threads)
    pcall(clear, connections)
    pcall(clear, logs)
    pcall(clear, remoteLogs)
    pcall(disablehooks)
    pcall(function()
        SimpleSpy3:Destroy()
    end)
    pcall(function()
        Storage:Destroy()
    end)
    pcall(function()
        UserInputService.MouseIconEnabled = true
    end)
    pcall(function()
        getgenv().SimpleSpyExecuted = false
    end)
end

