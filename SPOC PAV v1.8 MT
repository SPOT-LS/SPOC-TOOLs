		renameBtn.Activated:Connect(function()
			local renameBox = Instance.new("TextBox")
			renameBox.Size = UDim2.new(0, 98, 0, itemHeight)
			renameBox.Position = UDim2.new(0, 20, 0, 0)
			renameBox.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
			renameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
			renameBox.Text = preset.name or ("Cfg " .. i)
			renameBox.Font = Enum.Font.SourceSans
			renameBox.TextSize = 11
			renameBox.ClearTextOnFocus = false
			renameBox.Parent = row
			nameBtn.Visible = false
			renameBox:CaptureFocus()
			renameBox.FocusLost:Connect(function()
				local newName = renameBox.Text
				if newName and newName ~= "" then
					preset.name = newName
					persistSettingsPresets()
				end
				renameBox:Destroy()
				nameBtn.Visible = true
				nameBtn.Text = preset.name or ("Cfg " .. i)
			end)
		end)
		local deleteBtn = Instance.new("TextButton")
		deleteBtn.Size = UDim2.new(0, 18, 0, itemHeight)
		deleteBtn.Position = UDim2.new(0, 140, 0, 0)
		deleteBtn.BackgroundColor3 = Color3.fromRGB(140, 40, 40)
		deleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		deleteBtn.Text = "X"
		deleteBtn.Font = Enum.Font.SourceSansBold
		deleteBtn.TextSize = 10
		deleteBtn.Parent = row
		deleteBtn.Activated:Connect(function()
			table.remove(settingsPresets, i)
			persistSettingsPresets()
			refreshCfgPresetList()
		end)
		local rowIndex = i
		dragHandle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				cfgDragFromIndex = rowIndex
				cfgDragStartY = input.Position.Y
				cfgDragTouchId = input.UserInputType == Enum.UserInputType.Touch and input.Touch and input.Touch.TouchId or nil
			end
		end)
		dragHandle.InputEnded:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
			if cfgDragTouchId and input.UserInputType == Enum.UserInputType.Touch and input.Touch and input.Touch.TouchId ~= cfgDragTouchId then return end
			if not cfgDragFromIndex then return end
			local deltaY = input.Position.Y - (cfgDragStartY or input.Position.Y)
			local targetIndex = cfgDragFromIndex + math.floor((deltaY + itemHeight * 0.5) / (itemHeight + 2))
			targetIndex = math.clamp(targetIndex, 1, #settingsPresets)
			if targetIndex ~= cfgDragFromIndex then
				local moving = table.remove(settingsPresets, cfgDragFromIndex)
				table.insert(settingsPresets, targetIndex, moving)
				persistSettingsPresets()
				refreshCfgPresetList()
			end
			cfgDragFromIndex = nil
			cfgDragTouchId = nil
			cfgDragStartY = nil
		end)
	end
	local layout = PR.cfgPresetScroll:FindFirstChildOfClass("UIListLayout")
	if layout then
		PR.cfgPresetScroll.CanvasSize = UDim2.new(0, 0, 0, #settingsPresets * (itemHeight + layout.Padding.Offset))
	end
end

