local function getShellHeight(contentHeight)
	return contentHeight + EXT.PAD
end

local function animateShellOpen(shell, contentHeight)
	shell.Size = UDim2.new(0, EXT.W, 0, 0)
	local tween = TweenService:Create(shell, panelTweenInfo, {Size = UDim2.new(0, EXT.W, 0, getShellHeight(contentHeight))})
	tween:Play()
	return tween
end

local function animatePanelClose(panel, callback, gen)
	if not panel or not panel.Parent then
		if callback then callback() end
		return
	end
	local tween = TweenService:Create(panel, panelTweenInfo, {Size = UDim2.new(panel.Size.X.Scale, panel.Size.X.Offset, 0, 0)})
	tween:Play()
	tween.Completed:Connect(function()
		if gen and gen ~= BPanel.gen then return end
		if panel.Parent then panel:Destroy() end
		if callback then callback() end
	end)
end

closeBottomPanels = function(callback)
	BPanel.gen = BPanel.gen + 1
	local gen = BPanel.gen
	BPanel.id = nil
	BPanel.closing = true
	local wl = PR.whitelistShell
	local da = PR.dropAdvShell
	local near = PR.nearShell
	local cfg = PR.cfgPresetShell
	clearBottomPanelRefs()
	syncBottomPanelButtons()
	local shells = {}
	if wl then table.insert(shells, wl) end
	if da then table.insert(shells, da) end
	if near then table.insert(shells, near) end
	if cfg then table.insert(shells, cfg) end
	for _, child in ipairs(frame:GetChildren()) do
		if child.Name == "BottomPanelShell" then
			local tracked = false
			for _, sh in ipairs(shells) do
				if sh == child then tracked = true break end
			end
			if not tracked then table.insert(shells, child) end
		end
	end
	if #shells == 0 then
		BPanel.closing = false
		if callback and gen == BPanel.gen then callback() end
		return
	end
	local finished = 0
	local pending = #shells
	local function onOneDone()
		finished = finished + 1
		if finished >= pending then
			BPanel.closing = false
			if gen == BPanel.gen and callback then callback() end
		end
	end
	for _, sh in ipairs(shells) do
		animatePanelClose(sh, onOneDone, gen)
	end
end

local function setExtensionExpanded(expanded, animate)
	isExtensionExpanded = expanded
	extToggleBtn.Text = expanded and "◀" or "▶"
	if not expanded then
		closeBottomPanels()
	end
	local targetSize = UDim2.new(0, expanded and EXT.W or 0, 0, EXT.BAR_H)
	if animate then
		if extActiveTween then
			extActiveTween:Cancel()
			extActiveTween = nil
		end
		extActiveTween = TweenService:Create(extRoot, extTweenInfo, {Size = targetSize})
		extActiveTween:Play()
	else
		extRoot.Size = targetSize
	end
end

